# Copy this file to .env and fill in your own values.
# .env is for local secrets and should never be committed to git.

# MongoDB connection string.
# Local MongoDB example:
MONGO_URI=mongodb://localhost:27017

# MongoDB Atlas (cloud) example:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Name of the database Workloom will use.
DB_NAME=workloom_db

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173


# OpenAI API key for voice transcription and AI order extraction

# Groq API key for free-tier voice transcription and AI order extraction
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=replace-with-a-long-random-secret


# Pinterest API token (add after your Pinterest app receives API access).
# Keep this server-side; never put it in frontend/.env.
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here
PINTEREST_COUNTRY_CODE=IN
PINTEREST_LOCALE=en-IN
